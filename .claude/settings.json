{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(dotnet:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rev-parse:*)",
      "Bash(git config user.name)",
      "Bash(git config user.email)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push -u origin 0*)",
      "Bash(git push origin 0*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue create:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(uvx --from git+https://github.com/github/spec-kit.git specify:*)",
      "Bash(specify:*)",
      "Bash(.specify/scripts/bash/*)",
      "Bash(pwsh .specify/scripts/powershell/*)",
      "Bash(powershell .specify/scripts/powershell/*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(docker ps:*)",
      "Bash(docker version:*)",
      "Bash(docker compose:*)"
    ],
    "ask": [
      "Edit(**/approvals/**)",
      "Bash(*approvals*)",
      "Edit(.claude/**)",
      "Edit(.github/CODEOWNERS)",
      "Edit(.github/workflows/fabrica-gates.yml)",
      "Bash(gh api:*)",
      "Bash(gh label:*)",
      "Bash(gh repo edit:*)",
      "Bash(dotnet add package:*)",
      "Bash(rm:*)",
      "Bash(git rm:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow run:*)",
      "Bash(dotnet ef database update:*)",
      "Bash(dotnet ef database drop:*)",
      "Bash(dotnet nuget push:*)",
      "Bash(docker push:*)",
      "Bash(az:*)",
      "Bash(kubectl:*)",
      "Bash(helm:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/appsettings.Production.json)",
      "Read(**/secrets.json)"
    ]
  }
}
